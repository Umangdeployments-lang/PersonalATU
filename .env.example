# AEGIS-9 Environment Configuration
# Copy to .env and fill in your values

# Binance API (Testnet by default)
BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_api_secret
USE_TESTNET=true

# Deribit Options (for GEX)
DERIBIT_CLIENT_ID=your_deribit_client_id
DERIBIT_CLIENT_SECRET=your_deribit_client_secret

# Database
DATABASE_URL=postgresql://aegis9:aegis9@localhost:5432/aegis9
REDIS_URL=redis://localhost:6379/0

# Dashboard
DASHBOARD_PORT=5000
BACKEND_PORT=8000
UI_PORT=3000

# Risk Parameters
INITIAL_EQUITY=100.0
MAX_DAILY_DD_PCT=0.05
ALLOCATION_MODE=FULL_100

# Critic Gate
MIN_CRITIC_SCORE=9.0